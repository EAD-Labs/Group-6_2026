# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only by approved administration/provisioning scripts.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Application environment: local, staging or production
NEXT_PUBLIC_APP_ENV=local

# Server-only Gemini evaluator. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_CRAFT_MODEL=gemini-3.5-flash

# Project-management metadata; no Jira token is stored in this repository.
JIRA_BASE_URL=https://darshansonawane1110.atlassian.net
JIRA_PROJECT_KEY=KAN
