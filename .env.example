# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for trusted progress writes, staff operations and certificates.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Application environment: local, staging or production
NEXT_PUBLIC_APP_ENV=local

# Server-only Gemini evaluator. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_CRAFT_MODEL=gemini-3.5-flash

# Exact public site address used in account recovery links.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Server-only random secret for the daily retention cleanup endpoint.
# Set in Vercel before enabling the scheduled cleanup job.
CRON_SECRET=

# Project-management metadata; no Jira token is stored in this repository.
JIRA_BASE_URL=https://darshansonawane1110.atlassian.net
JIRA_PROJECT_KEY=KAN
